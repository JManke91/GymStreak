// MARK: - Units
// The unit word lives here and nowhere else: every compound string below takes
// a preformatted weight via %@. Baking "kg" into twenty values is what made the
// pounds support a localization change rather than a code change.
"unit.weight.kg" = "kg";
"unit.weight.lb" = "lb";
// Spoken forms, for VoiceOver — a screen reader saying "kay gee" is why.
"unit.weight.kg.spoken" = "Kilogramm";
"unit.weight.lb.spoken" = "Pfund";
// Tonnage rollup, for the volume figures on the history cards, the week hero and
// the month summaries. Kilograms roll up to the metric tonne at 1 000 kg; pounds
// have no equivalent unit — 1 000 lb is not one, and the short ton abbreviates
// one letter away from the tonne — so they keep "lb" and take a magnitude prefix
// on the *number* instead ("27,6k lb"). See docs/weight-unit-preference.md §10.
"unit.volume.t" = "t";
"unit.volume.thousand" = "k";

